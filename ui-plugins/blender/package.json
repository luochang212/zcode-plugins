{
  "name": "@zcode/plugin-blender",
  "version": "0.2.3",
  "private": true,
  "description": "ZCode Blender 插件：在对话旁打开 .blend 场景，让 Agent 修改物体、材质、相机并渲染预览。",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node --check server.mjs",
    "start": "node server.mjs",
    "test": "vitest run",
    "typecheck:ui": "tsc -p tsconfig.json",
    "build:ui": "node scripts/build-ui.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "stage": "node scripts/stage.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "three": "0.186.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/ext-apps": "2.0.0",
    "@types/three": "0.185.4",
    "esbuild": "^0.25.0"
  }
}
